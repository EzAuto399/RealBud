+test('rejects foreign ids, wrong kinds, and private fields in service output', async () => {
+  await rejectStatus(
+    api({ get: async () => ({ ...EXPORT_OP, id: OTHER }) })({ path: `${API}/operations/${ID}`, method: 'GET' }),
